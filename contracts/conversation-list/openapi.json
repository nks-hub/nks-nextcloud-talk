{
  "openapi": "3.1.0",
  "info": {
    "title": "Nextcloud Talk Conversation List Compatibility Contract",
    "version": "0.1.0",
    "description": "A clean-room compatibility contract for authenticated Talk conversation-v4 list reads. It describes an existing wire API and the fields required by the future account-scoped mobile store."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://cloud.example.invalid",
      "description": "Documentation-only Nextcloud origin"
    }
  ],
  "paths": {
    "/ocs/v2.php/apps/spreed/api/v4/room": {
      "get": {
        "operationId": "getConversationsV4",
        "summary": "Read conversations joined by the authenticated account",
        "description": "Returns either a full room list or the rooms selected by modifiedSince. The response cursor is committed only with the account-scoped database transaction that applies the response.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "OCS-APIRequest",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "true"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "const": "json"
            }
          },
          {
            "name": "noStatusUpdate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 0
            }
          },
          {
            "name": "includeStatus",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "modifiedSince",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "includeLastMessage",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation list returned",
            "headers": {
              "X-Nextcloud-Talk-Hash": {
                "required": true,
                "schema": {
                  "$ref": "#/components/schemas/OpaqueConfigurationHash"
                }
              },
              "X-Nextcloud-Talk-Modified-Before": {
                "required": true,
                "schema": {
                  "$ref": "#/components/schemas/DecimalCursor"
                }
              },
              "X-Nextcloud-Talk-Federation-Invites": {
                "required": false,
                "schema": {
                  "$ref": "#/components/schemas/DecimalCursor"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationListEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "The app password is missing or revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcsErrorEnvelope"
                }
              }
            }
          },
          "426": {
            "description": "The server requires a newer compatible client"
          },
          "429": {
            "description": "The request was rate limited"
          },
          "503": {
            "description": "The server is in maintenance or temporarily unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "The account login name and app password obtained through Login Flow v2"
      }
    },
    "schemas": {
      "OpaqueConfigurationHash": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[!-~]+$"
      },
      "DecimalCursor": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$",
        "maxLength": 20
      },
      "OcsMeta": {
        "type": "object",
        "required": [
          "status",
          "statuscode"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failure"
            ]
          },
          "statuscode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "additionalProperties": true
      },
      "ConversationListEnvelope": {
        "type": "object",
        "required": [
          "ocs"
        ],
        "properties": {
          "ocs": {
            "type": "object",
            "required": [
              "meta",
              "data"
            ],
            "properties": {
              "meta": {
                "$ref": "#/components/schemas/OcsMeta"
              },
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Conversation"
                },
                "maxItems": 100000
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "OcsErrorEnvelope": {
        "type": "object",
        "required": [
          "ocs"
        ],
        "properties": {
          "ocs": {
            "type": "object",
            "required": [
              "meta",
              "data"
            ],
            "properties": {
              "meta": {
                "$ref": "#/components/schemas/OcsMeta"
              },
              "data": {}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "ConversationToken": {
        "type": "string",
        "pattern": "^[a-z0-9]{4,30}$"
      },
      "RichObjectParameter": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "id": {
            "type": "string",
            "maxLength": 4096
          },
          "name": {
            "type": "string",
            "maxLength": 4096
          },
          "link": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "additionalProperties": true
      },
      "ConversationPreview": {
        "type": "object",
        "required": [
          "actorDisplayName",
          "actorId",
          "actorType",
          "expirationTimestamp",
          "message",
          "messageParameters",
          "messageType",
          "systemMessage"
        ],
        "properties": {
          "actorDisplayName": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "actorType": {
            "type": "string"
          },
          "expirationTimestamp": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          },
          "messageParameters": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/RichObjectParameter"
            }
          },
          "messageType": {
            "type": "string"
          },
          "systemMessage": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "isReplyable": {
            "type": "boolean"
          },
          "markdown": {
            "type": "boolean"
          },
          "reactions": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "referenceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "token": {
            "$ref": "#/components/schemas/ConversationToken"
          },
          "threadId": {
            "type": "integer",
            "format": "int64"
          },
          "threadTitle": {
            "type": "string"
          },
          "threadReplies": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      },
      "Conversation": {
        "type": "object",
        "required": [
          "actorId",
          "actorType",
          "attendeeId",
          "attendeePermissions",
          "attendeePin",
          "avatarVersion",
          "breakoutRoomMode",
          "breakoutRoomStatus",
          "callFlag",
          "callPermissions",
          "callRecording",
          "callStartTime",
          "canDeleteConversation",
          "canEnableSIP",
          "canLeaveConversation",
          "canStartCall",
          "defaultPermissions",
          "description",
          "displayName",
          "hasCall",
          "hasPassword",
          "id",
          "isCustomAvatar",
          "isFavorite",
          "lastActivity",
          "lastCommonReadMessage",
          "lastPing",
          "lastReadMessage",
          "listable",
          "liveTranscriptionLanguageId",
          "lobbyState",
          "lobbyTimer",
          "mentionPermissions",
          "messageExpiration",
          "name",
          "notificationCalls",
          "notificationLevel",
          "objectId",
          "objectType",
          "participantFlags",
          "participantType",
          "permissions",
          "readOnly",
          "recordingConsent",
          "sessionId",
          "sipEnabled",
          "token",
          "type",
          "unreadMention",
          "unreadMentionDirect",
          "unreadMessages",
          "isArchived",
          "isImportant",
          "isSensitive",
          "tagIds",
          "lastPinnedId",
          "hiddenPinnedId",
          "hasScheduledMessages",
          "attributes"
        ],
        "properties": {
          "actorId": {
            "type": "string"
          },
          "invitedActorId": {
            "type": "string"
          },
          "actorType": {
            "type": "string"
          },
          "attendeeId": {
            "type": "integer",
            "format": "int64"
          },
          "attendeePermissions": {
            "type": "integer",
            "format": "int64"
          },
          "attendeePin": {
            "type": [
              "string",
              "null"
            ]
          },
          "avatarVersion": {
            "type": "string"
          },
          "breakoutRoomMode": {
            "type": "integer"
          },
          "breakoutRoomStatus": {
            "type": "integer"
          },
          "callFlag": {
            "type": "integer"
          },
          "callPermissions": {
            "type": "integer"
          },
          "callRecording": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3,
              4,
              5
            ]
          },
          "callStartTime": {
            "type": "integer",
            "format": "int64"
          },
          "canDeleteConversation": {
            "type": "boolean"
          },
          "canEnableSIP": {
            "type": "boolean"
          },
          "canLeaveConversation": {
            "type": "boolean"
          },
          "canStartCall": {
            "type": "boolean"
          },
          "defaultPermissions": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "hasCall": {
            "type": "boolean"
          },
          "hasPassword": {
            "type": "boolean"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "isCustomAvatar": {
            "type": "boolean"
          },
          "isFavorite": {
            "type": "boolean"
          },
          "lastActivity": {
            "type": "integer",
            "format": "int64"
          },
          "lastCommonReadMessage": {
            "type": "integer",
            "format": "int64"
          },
          "lastMessage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConversationPreview"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastPing": {
            "type": "integer",
            "format": "int64"
          },
          "lastReadMessage": {
            "type": "integer",
            "format": "int64"
          },
          "listable": {
            "type": "integer"
          },
          "liveTranscriptionLanguageId": {
            "type": "string"
          },
          "lobbyState": {
            "type": "integer"
          },
          "lobbyTimer": {
            "type": "integer",
            "format": "int64"
          },
          "mentionPermissions": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "messageExpiration": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "notificationCalls": {
            "type": "integer"
          },
          "notificationLevel": {
            "type": "integer"
          },
          "objectId": {
            "type": "string"
          },
          "objectType": {
            "type": "string"
          },
          "participantFlags": {
            "type": "integer"
          },
          "participantType": {
            "type": "integer"
          },
          "permissions": {
            "type": "integer"
          },
          "readOnly": {
            "type": "integer"
          },
          "recordingConsent": {
            "type": "integer"
          },
          "remoteServer": {
            "type": "string"
          },
          "remoteToken": {
            "type": "string"
          },
          "sessionId": {
            "type": "string",
            "maxLength": 512
          },
          "sipEnabled": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "statusClearAt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "statusIcon": {
            "type": [
              "string",
              "null"
            ]
          },
          "statusMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "token": {
            "$ref": "#/components/schemas/ConversationToken"
          },
          "type": {
            "type": "integer"
          },
          "unreadMention": {
            "type": "boolean"
          },
          "unreadMentionDirect": {
            "type": "boolean"
          },
          "unreadMessages": {
            "type": "integer"
          },
          "isArchived": {
            "type": "boolean"
          },
          "isImportant": {
            "type": "boolean"
          },
          "isSensitive": {
            "type": "boolean"
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "lastPinnedId": {
            "type": "integer",
            "format": "int64"
          },
          "hiddenPinnedId": {
            "type": "integer",
            "format": "int64"
          },
          "hasScheduledMessages": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "attributes": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
