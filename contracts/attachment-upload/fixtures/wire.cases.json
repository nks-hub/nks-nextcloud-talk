{
  "cases": [
    {
      "id": "probe-wire-request",
      "kind": "probe",
      "input": {
        "accountId": "account-a",
        "requestId": "probe-0001",
        "server": "https://cloud.example.invalid/nextcloud",
        "roomToken": "rooma123",
        "fileNames": [
          "photo.jpg",
          "photo.jpg"
        ],
        "allowUpdate": false
      },
      "expected": {
        "operationId": "probeAttachmentFolder",
        "method": "POST",
        "uri": "https://cloud.example.invalid/nextcloud/ocs/v2.php/apps/spreed/api/v1/chat/rooma123/attachment/folder?format=json",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "OCS-APIRequest": "true",
          "User-Agent": "com.nkshub.nextcloudtalk attachment-contract/0.1"
        },
        "body": {
          "fileNames": [
            "photo.jpg",
            "photo.jpg"
          ],
          "allowUpdate": false
        },
        "binding": {
          "accountId": "account-a",
          "requestId": "probe-0001",
          "server": "https://cloud.example.invalid/nextcloud",
          "roomToken": "rooma123"
        }
      }
    },
    {
      "id": "finalize-wire-request",
      "kind": "finalize",
      "input": {
        "accountId": "account-a",
        "requestId": "finalize-0001",
        "server": "https://cloud.example.invalid/nextcloud",
        "roomToken": "rooma123",
        "filePath": "Talk/Synthetic room-rooma123/Draft/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa.upload",
        "referenceId": "11111111-1111-4111-8111-111111111111",
        "fileName": "photo.jpg",
        "expectedMessageType": "comment",
        "allowUpdate": false,
        "metadata": {
          "caption": "Synthetic caption",
          "silent": true,
          "threadId": 101,
          "threadTitle": "Synthetic thread"
        }
      },
      "expected": {
        "operationId": "finalizeAttachment",
        "method": "POST",
        "uri": "https://cloud.example.invalid/nextcloud/ocs/v2.php/apps/spreed/api/v1/chat/rooma123/attachment?format=json",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "OCS-APIRequest": "true",
          "User-Agent": "com.nkshub.nextcloudtalk attachment-contract/0.1"
        },
        "body": {
          "filePath": "Talk/Synthetic room-rooma123/Draft/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa.upload",
          "referenceId": "11111111-1111-4111-8111-111111111111",
          "talkMetaData": "{\"caption\":\"Synthetic caption\",\"silent\":true,\"threadId\":101,\"threadTitle\":\"Synthetic thread\"}",
          "fileName": "photo.jpg",
          "allowUpdate": false
        },
        "binding": {
          "accountId": "account-a",
          "requestId": "finalize-0001",
          "server": "https://cloud.example.invalid/nextcloud",
          "roomToken": "rooma123"
        }
      }
    },
    {
      "id": "voice-finalize-wire-request",
      "kind": "finalize",
      "input": {
        "accountId": "account-a",
        "requestId": "finalize-voice-0001",
        "server": "https://cloud.example.invalid/nextcloud",
        "roomToken": "rooma123",
        "filePath": "Talk/Synthetic room-rooma123/Draft/bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb.upload",
        "referenceId": "33333333-3333-4333-8333-333333333333",
        "fileName": "voice.mp3",
        "expectedMessageType": "voice-message",
        "allowUpdate": false,
        "metadata": {
          "messageType": "voice-message"
        }
      },
      "expected": {
        "operationId": "finalizeAttachment",
        "method": "POST",
        "uri": "https://cloud.example.invalid/nextcloud/ocs/v2.php/apps/spreed/api/v1/chat/rooma123/attachment?format=json",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "OCS-APIRequest": "true",
          "User-Agent": "com.nkshub.nextcloudtalk attachment-contract/0.1"
        },
        "body": {
          "filePath": "Talk/Synthetic room-rooma123/Draft/bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb.upload",
          "referenceId": "33333333-3333-4333-8333-333333333333",
          "talkMetaData": "{\"messageType\":\"voice-message\"}",
          "fileName": "voice.mp3",
          "allowUpdate": false
        },
        "binding": {
          "accountId": "account-a",
          "requestId": "finalize-voice-0001",
          "server": "https://cloud.example.invalid/nextcloud",
          "roomToken": "rooma123"
        }
      }
    },
