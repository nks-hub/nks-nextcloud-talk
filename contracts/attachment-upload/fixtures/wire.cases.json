    {
      "id": "safe-relative-path-encoded-once",
      "kind": "relativePath",
      "input": {
        "path": "Talk/Synthetic room-rooma123/Draft/příloha 1.jpg"
      },
      "expected": {
        "encodedPath": "Talk/Synthetic%20room-rooma123/Draft/p%C5%99%C3%ADloha%201.jpg"
      }
    },
    {
      "id": "absolute-uri-rejected",
