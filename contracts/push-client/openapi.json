{
  "openapi": "3.1.0",
  "info": {
    "title": "NKS Nextcloud Talk Push Client Compatibility Contract",
    "version": "0.1.0",
    "description": "Executable client-side contract for Notifications push-v2 registration, unregistration, encrypted mobile envelopes and bounded wake-up payloads."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://cloud.example.invalid",
      "description": "Documentation-only Nextcloud origin"
    }
  ],
  "paths": {
    "/ocs/v2.php/apps/notifications/api/v2/push": {
      "post": {
        "operationId": "registerPushDevice",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "OCS-APIRequest",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "true"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "const": "json"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PushRegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The current app-password registration already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcsPushRegistrationEnvelope"
                }
              }
            }
          },
          "201": {
            "description": "The registration was created or changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcsPushRegistrationEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "The registration material is invalid"
          },
          "401": {
            "description": "The app password is missing or revoked"
          },
          "429": {
            "description": "The request is rate limited"
          },
          "503": {
            "description": "The server is temporarily unavailable"
          }
        }
      },
      "delete": {
        "operationId": "unregisterPushDevice",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "OCS-APIRequest",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "true"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "const": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "No registration existed"
          },
          "202": {
            "description": "The registration was deleted and proxy cleanup is required"
          },
          "400": {
            "description": "The app-password session cannot be identified"
          },
          "401": {
            "description": "The app password is missing or revoked"
          },
          "429": {
            "description": "The request is rate limited"
          },
          "503": {
            "description": "The server is temporarily unavailable"
          }
        }
      }
    }
  },
  "webhooks": {
    "mobilePushEnvelope": {
      "post": {
        "operationId": "consumeMobilePushEnvelope",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobilePushEnvelope"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The opaque wake-up was accepted for local routing"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Account-specific app password obtained through Login Flow v2"
      }
    },
    "schemas": {
      "PushTokenHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{128}$"
      },
      "Rsa2048PublicKey": {
        "type": "string",
        "minLength": 450,
        "maxLength": 451
      },
      "PushRegistrationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pushTokenHash",
          "devicePublicKey",
          "proxyServer"
        ],
        "properties": {
          "pushTokenHash": {
            "$ref": "#/components/schemas/PushTokenHash"
          },
          "devicePublicKey": {
            "$ref": "#/components/schemas/Rsa2048PublicKey"
          },
          "proxyServer": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 256
          }
        }
      },
      "OcsMeta": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "status",
          "statuscode"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "statuscode": {
            "type": "integer",
            "const": 200
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "DeviceIdentifier": {
        "type": "string",
        "minLength": 88,
        "maxLength": 88,
        "pattern": "^[A-Za-z0-9+/]{86}==$"
      },
      "Rsa2048Signature": {
        "type": "string",
        "minLength": 344,
        "maxLength": 344,
        "pattern": "^[A-Za-z0-9+/]{342}==$"
      },
      "OcsPushRegistrationEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ocs"
        ],
        "properties": {
          "ocs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "meta",
              "data"
            ],
            "properties": {
              "meta": {
                "$ref": "#/components/schemas/OcsMeta"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "publicKey",
                  "deviceIdentifier",
                  "signature"
                ],
                "properties": {
                  "publicKey": {
                    "$ref": "#/components/schemas/Rsa2048PublicKey"
                  },
                  "deviceIdentifier": {
                    "$ref": "#/components/schemas/DeviceIdentifier"
                  },
                  "signature": {
                    "$ref": "#/components/schemas/Rsa2048Signature"
                  }
                }
              }
            }
          }
        }
      },
      "Rsa2048Ciphertext": {
        "type": "string",
        "minLength": 344,
        "maxLength": 344,
        "pattern": "^[A-Za-z0-9+/]{342}==$"
      },
      "MobilePushEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "signature"
        ],
        "properties": {
          "subject": {
            "$ref": "#/components/schemas/Rsa2048Ciphertext"
          },
          "signature": {
            "$ref": "#/components/schemas/Rsa2048Signature"
          }
        }
      },
      "NormalWakeUp": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "app": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "nid": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "DeleteOneWakeUp": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delete",
          "nid"
        ],
        "properties": {
          "delete": {
            "type": "boolean",
            "const": true
          },
          "nid": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "DeleteMultipleWakeUp": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delete-multiple",
          "nids"
        ],
        "properties": {
          "delete-multiple": {
            "type": "boolean",
            "const": true
          },
          "nids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "DeleteAllWakeUp": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delete-all"
        ],
        "properties": {
          "delete-all": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "WakeUpPayload": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/NormalWakeUp"
          },
          {
            "$ref": "#/components/schemas/DeleteOneWakeUp"
          },
          {
            "$ref": "#/components/schemas/DeleteMultipleWakeUp"
          },
          {
            "$ref": "#/components/schemas/DeleteAllWakeUp"
          }
        ]
      }
    }
  }
}
