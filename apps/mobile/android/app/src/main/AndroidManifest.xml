<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Live preview for reading a Nextcloud login QR code during onboarding.
         Nothing else in the app opens the camera: a photo attachment is taken
         by the system camera app through image_picker, which needs no
         permission here. The app never registers the nc:// scheme, so a
         scanned login payload can only ever arrive through this preview. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- A device without a camera can still do everything else, so the QR
         scanner must not keep the app off it. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false"/>
    <!-- The outbox drain job is scheduled as persisted, so a phone that
         rebooted with queued messages still gets woken for them. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Saving a chat picture to the device gallery. Android 10 and newer go
         through MediaStore and need no permission at all, so this is capped at
         API 29; only the minSdk 24 to 29 range still asks the user. A refusal
         surfaces in the image viewer as a message, never as a silent no-op. -->
    <!-- camera_android_camerax caps the same permission at 28 for its video
         recorder, which this app never starts. The gallery export above is
         what needs it, and that one needs it up to 29. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion"/>
    <!-- open_filex declares the three Android 13 media permissions in its own
         manifest for callers that hand it a shared-storage path. This app only
         ever opens attachments it wrote into its own application cache
         directory and hands them to another app through a FileProvider URI,
         which grants access per intent and needs no permission at all. Keeping
         them merged in would make Google Play demand a photo-and-video
         declaration for a capability the app does not use. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove"/>
    <!-- App icon unread badge on launchers that predate Android 8's native
         badges or need a manufacturer-specific API (app_badge_plus). These
         are normal, non-dangerous permissions; a launcher without support
         simply ignores them and app_badge_plus.isSupported() reports false. -->
    <uses-permission android:name="com.sec.android.provider.badge.permission.READ"/>
    <uses-permission android:name="com.sec.android.provider.badge.permission.WRITE"/>
    <uses-permission android:name="com.htc.launcher.permission.READ_SETTINGS"/>
    <uses-permission android:name="com.htc.launcher.permission.UPDATE_SHORTCUT"/>
    <uses-permission android:name="com.sonyericsson.home.permission.BROADCAST_BADGE"/>
    <uses-permission android:name="com.sonymobile.home.permission.PROVIDER_INSERT_BADGE"/>
    <uses-permission android:name="com.anddoes.launcher.permission.UPDATE_COUNT"/>
    <uses-permission android:name="com.majeur.launcher.permission.UPDATE_BADGE"/>
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE"/>
    <uses-permission android:name="com.huawei.android.launcher.permission.READ_SETTINGS"/>
    <uses-permission android:name="com.huawei.android.launcher.permission.WRITE_SETTINGS"/>
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="NKS Talk"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".push.AndroidWebPushActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Account-scoped Talk room links, e.g.
                 https://<server>/index.php/call/<token> or
                 https://<server>/call/<token>. Every account's server is
                 self-hosted and its hostname is unknown at build time, so no
                 android:host is set here: without one Android matches the
                 path pattern against any https host (see IntentFilter's
                 authority matching, which only restricts by host when at
                 least one android:host is declared). That also rules out
                 android:autoVerify="true": Android App Links verification
                 requires a Digital Asset Links file the app cannot publish
                 on every user's own server, so this intent-filter is offered
                 as a regular (non-verified) handler alongside the browser.
                 The Dart layer never trusts the link on its own: it only
                 opens a room when the link's origin matches an already
                 signed-in account. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:pathPattern="/index.php/call/.*"/>
                <data android:scheme="https" android:pathPattern="/call/.*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <receiver
            android:name=".push.AndroidWebPushReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter android:priority="500">
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>
        <service
            android:name=".push.AndroidWebPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name="org.unifiedpush.android.connector.internal.MessagingReceiverImpl"
            android:exported="false"
            tools:replace="android:exported" />
        <service
            android:name="org.unifiedpush.android.connector.internal.RaiseToForegroundService"
            android:exported="false"
            tools:replace="android:exported" />
        <!-- Push v2 over our own proxy. Registered alongside the UnifiedPush
             services above on purpose: both transports stay installed and the
             switch in settings decides which one ever registers. -->
        <service
            android:name=".push.NksFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Wakes the app on a network-constrained schedule to deliver what
             the outbox still holds and to resume interrupted uploads. Runs
             even when the app was never opened after a reboot. -->
        <service
            android:name=".background.BackgroundDrainJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
