# Copy to telemetry.env and fill in. telemetry.env is gitignored on purpose:
# a self-hosted Sentry DSN and Rybbit host are internal addresses and this
# repository is public.
#
# Build with:
#   flutter build apk --dart-define-from-file=telemetry.env
#
# Leaving a value empty disables that SDK completely - it is never initialised
# and the build reports nowhere. That is the default for every build that does
# not pass this file, which is what a third-party build of this client gets.

# Origin of the push gateway (the nks-talk-notify proxy) devices register
# with. Empty means this build never registers for push.
PUSH_GATEWAY_ORIGIN=

# Sentry DSN for crash reporting. Empty means no crash reporting.
SENTRY_DSN=

# Rybbit host and site id for anonymous screen usage. Both are required;
# either one empty means no analytics.
RYBBIT_HOST=
RYBBIT_SITE_ID=

# Tags events so a test build does not pollute production data.
TELEMETRY_ENVIRONMENT=development
